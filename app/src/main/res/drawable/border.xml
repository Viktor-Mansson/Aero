<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- This is the actual border (stroke) -->
    <stroke
        android:width="2dp"
        android:color="#FF0000" /> <!-- Red border, change to any color -->

    <!-- The background color inside the border -->
    <!-- Use @android:color/transparent if you only want the border -->
    <solid android:color="@android:color/transparent" />

    <!-- Optional: Add rounded corners -->
    <corners android:radius="8dp" />

    <!-- Optional: Add padding so the text doesn't touch the border line -->
    <padding
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp" />
</shape>